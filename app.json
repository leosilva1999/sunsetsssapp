{
  "expo": {
    "name": "Sunsetsss",
    "slug": "sunsetsss",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/brand-icon.png",
    "scheme": "sunsetsss",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/brand-icon.png",
        "backgroundColor": "#1e1038"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/brand-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/brand-logo-vertical.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1e1038"
        }
      ],
      "expo-secure-store",
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "O app precisa de acesso às suas fotos pra você postar um pôr do sol.",
          "cameraPermission": "O app precisa da câmera pra você tirar uma foto do pôr do sol."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Usamos sua localização só pra preencher as coordenadas quando você cadastra um local novo."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
