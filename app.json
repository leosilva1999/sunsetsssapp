{
  "expo": {
    "name": "Sunsetsss",
    "slug": "sunsetsss",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/brand-icon.png",
    "scheme": "sunsetsss",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/brand-icon.png",
        "backgroundColor": "#1e1038"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/brand-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/brand-logo-vertical.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1e1038"
        }
      ],
      "expo-secure-store",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
