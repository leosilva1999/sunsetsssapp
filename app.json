{
  "expo": {
    "name": "Sunsetsss",
    "slug": "sunsetsss",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/brand-icon.png",
    "scheme": "sunsetsss",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sunsetsss.app"
    },
    "android": {
      "package": "com.sunsetsss.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/brand-icon-adaptive.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/brand-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/brand-logo-vertical.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-secure-store",
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "O app precisa de acesso às suas fotos pra você postar um pôr do sol.",
          "cameraPermission": "O app precisa da câmera pra você tirar uma foto do pôr do sol."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Usamos sua localização para mostrar locais perto de você e preencher as coordenadas ao cadastrar um local novo."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "daff8e8a-e5d3-405f-aa0f-6f12e4f7575f"
      }
    },
    "owner": "leosilva1999"
  }
}
