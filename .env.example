# Copie para `.env` e ajuste. Veja src/lib/env.ts.
# Dev local (dotnet run --project src/Sunset.API, via docs/API.md): http://localhost:5256
# Emulador Android: use http://10.0.2.2:5256 em vez de localhost.
# Dispositivo físico: use o IP da máquina host na rede local, ex. http://192.168.0.10:5256
EXPO_PUBLIC_API_BASE_URL=http://localhost:5256

# Opcional — mapa embutido no Detalhe do local (WebView + Google Maps Embed API). Sem isso, a
# tela só não mostra o mapa, não quebra. Mesma key usada pelo sunsetweb (NEXT_PUBLIC_GOOGLE_CLIENT_ID
# não, essa é outra — procure NEXT_PUBLIC_GOOGLE_MAPS_API_KEY no .env.local do sunsetweb) — se
# ela estiver restrita por HTTP referrer (pro domínio web), pode não funcionar numa WebView;
# nesse caso crie uma key própria pro mobile no Google Cloud Console.
EXPO_PUBLIC_GOOGLE_MAPS_EMBED_KEY=

# Chave do Maps SDK for Android (Google Cloud), restrita ao package com.sunsetsss.app + SHA-1 do
# build — usada pelo mapa de seleção de local em builds nativos (app.config.js). No Expo Go não é
# necessária. Lida na hora do build/prebuild, não em runtime.
GOOGLE_MAPS_ANDROID_API_KEY=

# Client ID *Web* do Google Cloud — o mesmo `GoogleAuth:ClientId` do backend (appsettings). Usado
# no login com Google (build nativo; no Expo Go o botão avisa que precisa do build).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
